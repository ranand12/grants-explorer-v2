   "roundness": null,
   "seed": 181242850,
   "version": 1,
   "versionNonce": 419812754,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "\u2713 ADK runs: 3 \u00d7 LlmAgent \u00b7 Runner.run_live (voice, barge-in, tool calls mid-speech) \u00b7 DatabaseSessionService (one thread across voice + text, user: state for shortlist/profile)\n    \u00b7 FunctionTool + ToolContext \u00b7 built-in google_search \u00b7 after_model_callback (citations) \u00b7 ag_ui_adk bridge to CopilotKit",
   "originalText": "\u2713 ADK runs: 3 \u00d7 LlmAgent \u00b7 Runner.run_live (voice, barge-in, tool calls mid-speech) \u00b7 DatabaseSessionService (one thread across voice + text, user: state for shortlist/profile)\n    \u00b7 FunctionTool + ToolContext \u00b7 built-in google_search \u00b7 after_model_callback (citations) \u00b7 ag_ui_adk bridge to CopilotKit",
   "fontSize": 14,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
