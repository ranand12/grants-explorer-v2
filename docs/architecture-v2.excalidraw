  {
   "id": "text-128",
   "type": "text",
   "x": 1040,
   "y": 1112,
   "width": 816.2,
   "height": 52.5,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1806584668,
   "version": 1,
   "versionNonce": 561623934,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "One conversation: threadId = userId~conv is the CopilotKit thread, the ADK session and the /live session,\nso switching voice \u2194 text keeps history, dashboard, shortlist and profile. Every tool publishes to ui_bus,\nso views update mid-sentence in voice and in text (chips, streaming draft sections).",
   "originalText": "One conversation: threadId = userId~conv is the CopilotKit thread, the ADK session and the /live session,\nso switching voice \u2194 text keeps history, dashboard, shortlist and profile. Every tool publishes to ui_bus,\nso views update mid-sentence in voice and in text (chips, streaming draft sections).",
   "fontSize": 14,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "text-129",
   "type": "text",
   "x": 90,
   "y": 1156,
   "width": 777.7,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 652132316,
   "version": 1,
   "versionNonce": 80336782,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Every screen is pushed to history \u2192 Back / Forward / breadcrumbs / browser back all work.\nEvery screen carries its sources \u2192 card footers, Sources panel, numbered chips, draft evidence flags.",
   "originalText": "Every screen is pushed to history \u2192 Back / Forward / breadcrumbs / browser back all work.\nEvery screen carries its sources \u2192 card footers, Sources panel, numbered chips, draft evidence flags.",
   "fontSize": 14,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
