  {
   "id": "text-138",
   "type": "text",
   "x": 90,
   "y": 1286,
   "width": 1355.2,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#2b8a3e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
